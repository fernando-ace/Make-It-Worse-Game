NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Public deployment markers are configuration, not secrets. Set beta/test refs
# to the exact project used by that environment; loopback Supabase is detected
# as local for ephemeral development and CI.
NEXT_PUBLIC_DEPLOYMENT_CLASS=development
NEXT_PUBLIC_BETA_SUPABASE_PROJECT_REF=
NEXT_PUBLIC_TEST_SUPABASE_PROJECT_REF=
SUPABASE_PROJECT_REF=
BETA_SUPABASE_PROJECT_REF=
TEST_SUPABASE_PROJECT_REF=
# Server only. Never prefix this variable with NEXT_PUBLIC_. Legacy service_role also works.
SUPABASE_SECRET_KEY=sb_secret_...
# Required in Vercel production for the scheduled room and beta-data cleanup.
CRON_SECRET=use-a-long-random-value
